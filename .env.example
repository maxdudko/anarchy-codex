# Copy to .env and adjust as needed. Defaults match local demo values.

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password123
MONGO_DB=anarchy-codex
MONGO_PORT=27017

# Mongo Express (docker compose --profile tools)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=password123
MONGO_EXPRESS_PORT=8081

# API
API_PORT=3001
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
FRONTEND_URL=http://localhost:3000
MAX_FILE_SIZE=10485760

# Client (browser must reach the API on the host)
CLIENT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
